{{- if lookPath "steam" -}}
{{- $prefix := "env LD_PRELOAD=/home/chilli/Sources/extest/target/x86_64-unknown-linux-gnu/release/libextest.so" -}}
{{- $steamPath := lookPath "steam" -}}
{{- $params := "-silent" -}}
{{- $exec := cat $prefix $steamPath $params -}}
[Desktop Entry]
Name=Steam
Comment=Application for managing and playing games on Steam
Exec={{ $exec }} %U
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=Store;Community;Library;Servers;Screenshots;News;Settings;BigPicture;Friends;
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true

[Desktop Action Store]
Name=Store
Exec={{ $exec }} steam://store

[Desktop Action Community]
Name=Community
Exec={{ $exec }} steam://url/CommunityHome/

[Desktop Action Library]
Name=Library
Exec={{ $exec }} steam://open/games

[Desktop Action Servers]
Name=Servers
Exec={{ $exec }} steam://open/servers

[Desktop Action Screenshots]
Name=Screenshots
Exec={{ $exec }} steam://open/screenshots

[Desktop Action News]
Name=News
Exec={{ $exec }} steam://openurl/https://store.steampowered.com/news

[Desktop Action Settings]
Name=Settings
Exec={{ $exec }} steam://open/settings

[Desktop Action BigPicture]
Name=Big Picture
Exec={{ $exec }} steam://open/bigpicture

[Desktop Action Friends]
Name=Friends
Exec={{ $exec }} steam://open/friends
{{ end -}}
